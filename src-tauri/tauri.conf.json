{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Celluloid Desktop",
  "version": "1.6.0",
  "identifier": "com.celluloid.desktop",
  "build": {
    "beforeDevCommand": "pnpm ensure:sidecars && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm ensure:sidecars && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Celluloid Desktop",
        "width": 800,
        "height": 1080,
        "minWidth": 640,
        "minHeight": 600,
        "resizable": true,
        "maximizable": false,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBRDg0NDFGN0U2RTNGQ0YKUldUUFAyNStIMFRZK2hJLzFPZHIrTnJCY09ESFFGZVJRUDF1THFpQkZiam5ROFhsblVFeUJ3cmcK",
      "endpoints": [
        "https://github.com/celluloid-camp/desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
